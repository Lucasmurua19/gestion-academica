# Copiá este archivo como ".env" para cambiar los valores de docker-compose.
# Si no existe ".env", se usan los valores por defecto (sirven para la demo).

# Puertos de tu compu (si el 8080 o el 5201 ya están ocupados, cambialos acá)
WEB_PORT=8080
API_PORT=5201

# Contraseña del usuario "sa" de SQL Server (mínimo 8 caracteres con mayúscula, minúscula y número)
MSSQL_SA_PASSWORD=Demo_Passw0rd_2026

# Clave con la que la API firma los tokens (mínimo 32 caracteres)
JWT_KEY=clave-de-demostracion-docker-compose-cambiar-en-serio

# Cuenta de administrador que se crea al arrancar
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=Admin_Demo_2026
